{% extends "base.html.twig" %}

{% block meta_tags %}
    <title>{{ page.title }} | {{ site.siteTitle }}</title>
    {% if page.description %}
        <meta name="description" content="{{ page.description }}">
    {% endif %}
    <link rel="canonical" href="{{ site.baseUrl }}/{{ page.slug }}.html">
    <meta property="og:title" content="{{ page.title }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.baseUrl }}/{{ page.slug }}.html">
{% endblock meta_tags %}

{% block content %}
    <h1>{{ page.title }}</h1>
    <div>{{ page.content|raw }}</div>
{% endblock content %}