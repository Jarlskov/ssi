{% extends "base.html.twig" %}

{% block content %}
    {% if index_content %}
        <div class="index-introduction">
            {{ index_content|raw }}
        </div>
    {% else %}
        <h1>{{ site.siteTitle }}</h1>
        <p>Welcome to my personal blog.</p>
    {% endif %}

    <h2>Latest Posts</h2>
    {% if posts is empty %}
        <p>No posts yet. Check back soon!</p>
    {% else %}
        <ul>
            {% for post in posts %}
                <li>
                    <h3><a href="/{{ post.slug }}.html">{{ post.title }}</a></h3>
                    <p><small>Published on {{ post.date|date("Y-m-d") }} by {{ site.author }}</small></p>
                    <p>{{ post.description }}</p>
                    {% if post.tags is not empty %}
                        <p>
                            Tags:
                            {% for tag in post.tags %}
                                <a href="/tags/{{ tag|url_encode(true) }}.html">#{{ tag }}</a>{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        </p>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock content %}