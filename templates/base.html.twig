<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        {# ================================================================= #}
        {#  META TAGS BLOCK                                                  #}
        {#  Child templates will override this to provide specific meta tags.#}
        {# ================================================================= #}
        {% block meta_tags %}
            <title>{{ site.siteTitle }}</title>
            <meta name="description" content="{{ site.siteTitle }} - A personal blog by {{ site.author }}">
            <meta property="og:title" content="{{ site.siteTitle }}">
            <meta property="og:image" content="{{ site.baseUrl }}{{ site.defaultSocialImage }}">
            <meta property="og:type" content="website">
            <meta property="og:url" content="{{ site.baseUrl }}/">
        {% endblock meta_tags %}

        <link rel="stylesheet" href="/assets/css/style.css">
    </head>
    <body>
        {% apply spaceless %}
            {% include 'partials/header.html.twig' %}

            <main>
                {% block content %}{% endblock content %}
            </main>

            <footer>
                {% block footer %}
                    <p>&copy; {{ "now"|date("Y") }} {{ site.author }}</p>
                {% endblock footer %}
            </footer>

            {# ---- SCRIPTS BLOCK ---- #}
            {% block scripts %}
                {# Mermaid.js Support #}
                <script type="module">
                    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
                    mermaid.initialize({ startOnLoad: true });
                </script>
            {% endblock scripts %}
        {% endapply %}
    </body>
</html>
